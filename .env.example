# Blank values are intentional. Supply YOUR credentials in Settings after initialization.
SECRETORY_PRIVATE_AUTH=1
SECRETORY_PASSWORD_HASH=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EXTRACTOR_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
TG_BOT_TOKEN=
OWNER_USER_ID=0
OWNER_FIRST_NAME=Alex
ASSISTANT_SIGNATURE=
DB_PATH=./runtime/khadang.db
PROMPTS_DIR=./prompts
MESSAGE_RETENTION_DAYS=7
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8780
DASHBOARD_LANG=en
# Opt in only after understanding that daily excerpts are sent to your model provider.
REPORTS_ENABLED=false
URGENT_ALERTS_ENABLED=false
# Optional Telegram HTTP proxy; leave empty for a direct connection.
TELEGRAM_PROXY_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
